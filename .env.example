# Copy to .env.local (gitignored) and fill in. Variables already exported in
# the shell win over this file. Loaded by tests/_helpers/env.js.

# Platform One admin of the env in testrail.config.json (appUnderTest.url).
# The same password is used by dummy-firm users (admin_N, adv_N_M) and timN.
TIM1_USERNAME=tim1
TIM1_PASSWORD=

# Oracle user for the direct-DB helpers. The DSN comes from GEO_DB_DSN or is
# derived from appUnderTest.url (tests/_helpers/qa3.js resolveDbDsn).
GEO_DB_USER=
GEO_DB_PASSWORD=

# Password the suite sets on users it creates (GW admins, client portal users).
# Must contain upper and lower case letters, a digit and a special character.
GEO_TEST_USER_PASSWORD=

# AIO Tests API token (alternative: ~/.aio-tests-token).
AIO_TOKEN=

# TestRail (license expired 2026-08-28; only used by scripts/sync-pepi-*.js).
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_PASSWORD=
TESTRAIL_API_KEY=
